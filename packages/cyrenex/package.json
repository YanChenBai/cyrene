{
  "name": "cyrenex",
  "version": "0.0.0",
  "description": "A declarative, type-safe dependency graph runtime for TypeScript with async initialization and resource disposal",
  "keywords": [
    "async-initialization",
    "dependency-graph",
    "dependency-injection",
    "lifecycle",
    "resource-management",
    "typescript"
  ],
  "homepage": "https://github.com/YanChenBai/cyrene#readme",
  "bugs": {
    "url": "https://github.com/YanChenBai/cyrene/issues"
  },
  "license": "MIT",
  "author": "byc <bycrxemail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanChenBai/cyrene",
    "directory": "packages/cyrenex"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vpr build",
    "ready": "vp check && vp test run && vpr build"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
